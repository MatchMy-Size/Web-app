PORT=8080

# Supabase PostgreSQL session-pooler connection. The jdbc: prefix is required.
JDBC_DATABASE_URL=jdbc:postgresql://your-pooler-host:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_POOL_SIZE=5

# Supabase Auth and JWT verification.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated web origins, without trailing slashes.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app
PHONE_PASSWORD_DOMAIN=phone.whatmysize.app

# Text.lk is server-side only. Never put this token in frontend variables.
TEXTLK_API_TOKEN=your-textlk-api-token
TEXTLK_SENDER_ID=MatchMySize
TEXTLK_BASE_URL=https://app.text.lk/api/v3
TEXTLK_OTP_TEMPLATE=Your MatchMySize verification code is {code}. It expires in {minutes} minutes.
TEXTLK_OTP_TTL_MS=300000
